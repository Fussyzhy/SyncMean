# =============================================================================
# 同声传意 · 环境变量模板（v3.5）
#
# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会被提交）：
#   cp .env.example .env
# 进程环境变量优先于 .env（Docker / systemd 用 -e ADMIN_KEY=... 覆盖即可）。
# =============================================================================

# 服务端口（默认 3210）
PORT=3210

# 管理后台 /admin 的访问密钥：必填。
# 留空 = 管理后台禁用（/admin 会提示「服务端未配置 ADMIN_KEY」）。
# 建议使用 16 位以上随机字符串（生成：node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"）
ADMIN_KEY=change-me-to-a-long-random-string

# =============================================================================
# 语音连麦（v3.7）—— 可选，不配也能玩（用默认 STUN；P2P 打不通时前端提示降级）
#
# 麦克风只在安全上下文可用：HTTPS（推荐 Caddy/Nginx 反代）或 localhost。
# 局域网 http://<IP>:3210 下语音 UI 会自动隐藏，游戏不受影响。
# =============================================================================

# STUN 服务器（逗号分隔；留空表示不用 STUN，只靠本机候选，一般仅适合同一局域网）
STUN_URLS=stun:stun.miwifi.com:3478,stun:stun.chat.bilibili.com:3478

# TURN 中继（可选）：对称 NAT / 部分移动网络下 P2P 打不通时需要。
# 配置后 /rtc-config 会下发在客户端，凭据本身对玩家可见（TURN 机制决定），
# 建议使用短期凭据或专门的低权限账号。
#TURN_URL=turn:turn.example.com:3478
#TURN_USERNAME=
#TURN_CREDENTIAL=

# =============================================================================
# 小内存服务器（2C2G）部署 —— 只有用「只拉镜像」方式（docker-compose.prod.yml）时才需要
# 详见 README §8
#
# 推荐：在别处构建好镜像，服务器只 pull。镜像地址必须写（不写 compose 会直接报错提示）：
#SYNCMEAN_IMAGE=ghcr.io/fussyzhy/syncmean:latest
#
# 容器内存硬上限（默认 512m，应用常驻只有几十 MB，够用）
#APP_MEM_LIMIT=512m
#
# 容器端口绑定的网卡：前面挂 Nginx/Caddy 时改成 127.0.0.1（默认对所有网卡开放）
#SYNCMEAN_BIND=0.0.0.0
#
# 安装生产依赖时的堆上限（默认 768MB，2C2G 够用；构建机内存大可以调高）
#NODE_BUILD_HEAP=768
# =============================================================================

