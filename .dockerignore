# 依赖：镜像里用 yarn 重新装（宿主机 node_modules 含 Windows 二进制，不能拷进 Linux 镜像）
node_modules

# 构建产物 dist/ 这里**不要**排除：
# docker-compose.yml 默认的 Dockerfile.prebuilt 会直接把仓库里的 dist/ COPY 进镜像（README §8）；
# 从源码构建的 Dockerfile 不读上下文里的 dist（builder 阶段自己生成），多传几百 KB 无所谓。

# 测试 / 验收 / 版本库 / 编辑器：不进运行时镜像
tools
.verify
.git
.gitignore
.env
.env.*
*.log
*.tsbuildinfo
.DS_Store
.vscode
.idea

# 部署脚本与 CI：构建用不到
deploy
.github

# 文档与编排文件本身
README.md
PROTOCOL.md
docker-compose.yml
docker-compose.prod.yml
docker-compose.prebuilt.yml
.dockerignore
